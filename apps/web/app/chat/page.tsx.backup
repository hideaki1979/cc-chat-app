'use client';

import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import { useAuthStore } from '../stores/auth';
import { useChat } from '../hooks/useChat';
import { ChatLayout, Sidebar, ChatHeader } from '../components/layout';
import { ChatArea } from '../components/chat';
import type { ChatRoom } from '../types/chat';


export default function ChatPage() {
  const router = useRouter();
  const { user, isLoading, isInitialized, logout, initializeAuth } = useAuthStore();
  
  const {
    rooms,
    currentRoomId,
    currentRoomMessages,
    isLoading: chatLoading,
    fetchRooms,
    selectRoom,
    sendMessage
  } = useChat();
  
  const [selectedRoom, setSelectedRoom] = useState<ChatRoom | null>(null);
  const [initStarted, setInitStarted] = useState(false);
  const [error, setError] = useState<string | null>(null);
  
  // デバッグ用ログ
  console.log('ChatPage render:', {
    isLoading,
    isInitialized, 
    user: user ? `${user.name} (${user.id})` : null,
    chatLoading,
    error,
    roomsCount: rooms.length
  });

  // 初期化処理（一度だけ実行）
  useEffect(() => {
    if (!isInitialized && !initStarted) {
      setInitStarted(true);
      initializeAuth();
    }
  }, [isInitialized, initStarted, initializeAuth]);

  // ユーザー認証完了後にルーム一覧を取得
  useEffect(() => {
    if (isInitialized && user && !chatLoading) {
      fetchRooms().catch((error) => {
        console.error('Failed to fetch rooms:', error);
        setError('チャットルームの取得に失敗しました。しばらくしてからお試しください。');
      });
    }
  }, [isInitialized, user, chatLoading, fetchRooms]);

  const handleRoomSelect = async (roomId: string) => {
    try {
      setError(null);
      await selectRoom(roomId);
      const room = rooms.find(r => r.id === roomId) || null;
      setSelectedRoom(room);
    } catch (error) {
      console.error('Failed to select room:', error);
      setError('メッセージの取得に失敗しました。しばらくしてからお試しください。');
    }
  };

  const handleSendMessage = async (content: string) => {
    if (!currentRoomId || !user) return;

    try {
      setError(null);
      await sendMessage(currentRoomId, content);
    } catch (error) {
      console.error('Failed to send message:', error);
      setError('メッセージの送信に失敗しました。しばらくしてからお試しください。');
    }
  };

  const handleCreateRoom = () => {
    alert('ルーム作成機能は今後実装予定です');
  };

  const handleLogout = async () => {
    await logout();
    router.push('/login');
  };

  const handleRoomSettings = () => {
    alert('ルーム設定機能は今後実装予定です');
  };

  const handleVideoCall = () => {
    alert('ビデオ通話機能は今後実装予定です');
  };

  const handleVoiceCall = () => {
    alert('音声通話機能は今後実装予定です');
  };

  // 初期化中はローディング表示
  if (isLoading || !isInitialized) {
    console.log('ChatPage: Showing loading screen', { isLoading, isInitialized });
    return (
      <div className="min-h-screen flex items-center justify-center">
        <p>ユーザー情報を読み込み中...</p>
      </div>
    );
  }

  // middlewareで認証チェック済みのため、userがnullの場合は初期化エラー
  if (!user) {
    console.log('ChatPage: Showing auth error screen');
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-center">
          <p className="text-red-600 mb-4">認証エラーが発生しました</p>
          <button
            onClick={() => router.push('/login')}
            className="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
          >
            ログイン画面に戻る
          </button>
        </div>
      </div>
    );
  }

  // エラー表示
  if (error) {
    console.log('ChatPage: Showing error screen:', error);
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-center max-w-md mx-auto p-6">
          <div className="mb-4">
            <svg
              className="mx-auto h-12 w-12 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.959 8.959 0 01-4.906-1.471c-.908-.556-2.094-.556-3.002 0A8.959 8.959 0 015 20c-4.418 0-8-3.582-8-8s3.582-8 8-8 8 3.582 8 8z"
              />
            </svg>
          </div>
          <h3 className="text-lg font-medium text-gray-900 mb-2">
            チャットルームの読み込みに失敗しました
          </h3>
          <p className="text-gray-600 mb-6">{error}</p>
          <div className="space-y-2">
            <button
              onClick={() => {
                setError(null);
                fetchRooms().catch((error) => {
                  console.error('Failed to retry fetch rooms:', error);
                  setError('チャットルームの取得に失敗しました。');
                });
              }}
              className="w-full px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
            >
              再試行
            </button>
            <button
              onClick={() => router.push('/dashboard')}
              className="w-full px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400"
            >
              ダッシュボードに戻る
            </button>
          </div>
        </div>
      </div>
    );
  }

  // ルームが空の場合の表示
  if (rooms.length === 0 && !chatLoading && !error) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-center max-w-md mx-auto p-6">
          <div className="mb-4">
            <svg
              className="mx-auto h-12 w-12 text-gray-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.959 8.959 0 01-4.906-1.471c-.908-.556-2.094-.556-3.002 0A8.959 8.959 0 015 20c-4.418 0-8-3.582-8-8s3.582-8 8-8 8 3.582 8 8z"
              />
            </svg>
          </div>
          <h3 className="text-lg font-medium text-gray-900 mb-2">
            チャットルームがありません
          </h3>
          <p className="text-gray-600 mb-6">
            まだチャットルームがありません。新しいルームを作成して会話を始めましょう。
          </p>
          <div className="space-y-2">
            <button
              onClick={handleCreateRoom}
              className="w-full px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600"
            >
              新しいルームを作成
            </button>
            <button
              onClick={() => router.push('/dashboard')}
              className="w-full px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400"
            >
              ダッシュボードに戻る
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <ChatLayout
      sidebar={
        <Sidebar
          rooms={rooms}
          currentRoomId={currentRoomId || undefined}
          onRoomSelect={handleRoomSelect}
          onCreateRoom={handleCreateRoom}
          user={user}
          onLogout={handleLogout}
        />
      }
      header={(props) => (
        <ChatHeader
          {...props}
          roomName={selectedRoom?.name}
          isGroupChat={selectedRoom?.is_group_chat}
          memberCount={selectedRoom?.member_count}
          onlineCount={selectedRoom?.is_group_chat ? 5 : selectedRoom ? 1 : 0} // TODO: 実際のオンライン数を取得
          onRoomSettings={handleRoomSettings}
          onVideoCall={handleVideoCall}
          onVoiceCall={handleVoiceCall}
        />
      )}
    >
      {/* チャットメインエリア */}
      <ChatArea
        roomId={currentRoomId || undefined}
        roomName={selectedRoom?.name}
        messages={currentRoomMessages}
        currentUserId={user?.id}
        onSendMessage={handleSendMessage}
      />
    </ChatLayout>
  );
}